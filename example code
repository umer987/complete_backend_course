//lesson 1
const express = require('express');
const app = express();
const PORT = 3000;

//lesson 2
app.get('/', (req, res) => {
  res.send('Hello World!');
});
//lesson 3
app.listen(PORT, () => {
  console.log(`Server running on http://localhost:${PORT}`);
});
//lesson 2
app.get('/users/:userId', (req, res) => {
  const userId = req.params.userId;
  res.send(`User ID: ${userId}`);
});

// Example: GET /users/42 → "User ID: 42"

//lesson 4
app.get('/search', (req, res) => {
  const { q, limit } = req.query;
  res.send(`Searching for "${q}" with limit ${limit || 10}`);
});

// Example: GET /search?q=express&limit=5 → "Searching for 'express' with limit 5"

//lesson 5
app.use(express.json());

app.post('/api/data', (req, res) => {
  const { name, age } = req.body;
  res.json({ message: `Received: ${name}, age ${age}` });
});

// POST /api/data with body: {"name":"Alice","age":30}

